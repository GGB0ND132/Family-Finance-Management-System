# 复制为 .env 后按本机环境修改；.env 不得提交到版本库
APP_ENV=development

# MySQL 连接串（SQLAlchemy 格式）
DATABASE_URL=mysql+pymysql://root:change-me@localhost:3306/family_finance?charset=utf8mb4

# JWT 配置
JWT_SECRET_KEY=please-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许访问 API 的前端地址（JSON 数组）
CORS_ORIGINS=["http://localhost:5173"]

# 导入文件大小上限（字节），默认 10MB
IMPORT_MAX_FILE_SIZE=10485760